# Contoh konfigurasi. Salin menjadi `.env` lalu isi nilainya sendiri.
#
# Token bot Telegram (buat bot baru via @BotFather, atau pakai bot RS yang sudah ada)
TELEGRAM_BOT_TOKEN=
# Chat tujuan notifikasi pendaftaran (ID grup internal, isi sendiri).
TELEGRAM_CHAT_ID=

# Token untuk SIMRS mengirim data ketersediaan tempat tidur ke POST /api/simrs/kasur
SIMRS_API_TOKEN=
